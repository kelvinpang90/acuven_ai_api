# 本地演示可用 SQLite；VPS 上用共享 MySQL 里的独立库：mysql+pymysql://<用户>:<密码>@mysql:3306/acuven_ai_api
AI_API_DATABASE_URL=sqlite:///./acuven_ai_api.db
# 整段 JSON 在 VPS 的 .env 里用单引号包住（compose 不再做变量替换）。
AI_API_CLIENTS_JSON=[{"client_id":"crm-demo","token_sha256":"<64-character-sha256>","tenant_id":"<tenant-public-id>","billing_project_id":"<project-public-id>","billing_api_key":"<ak-value>","billing_secret":"<sk-value>","billing_key_version":1,"capabilities":["crm.contact_summary"]}]
AI_API_ANTHROPIC_KEY=<provider-api-key>
AI_API_ANTHROPIC_MODEL=claude-sonnet-4-6
# 只写源地址，不带路径；本机以外必须是 HTTPS。
AI_API_BILLING_BASE_URL=http://localhost:8001
